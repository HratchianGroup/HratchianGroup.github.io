---
import Layout from '../layouts/Layout.astro';
import { resourceSections } from '../data/resources';
---

<Layout title="Resources | Hratchian Research Group">
  <main id="main-content">
    <header class="page-intro">
      <h1>Resources</h1>
      <p>Journals, group resources, and useful links for research at UC Merced.</p>
    </header>

    <div class="resource-columns">
      {resourceSections.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          <ul>
            {section.links.map((link) => (
              <li><a href={link.url}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .page-intro { margin-bottom: 3rem; }
  .page-intro p { color: var(--muted); max-width: 42rem; }
  .resource-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem 4rem; align-items: start; }
  section { border-top: 3px solid var(--accent); padding-top: 1.5rem; }
  section:first-child { grid-row: span 3; }
  h2 { margin: 0 0 1.25rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid var(--line); }
  li a { display: block; padding: 0.75rem 0; overflow-wrap: anywhere; }
  @media (max-width: 800px) {
    .resource-columns { grid-template-columns: 1fr; gap: 2.5rem; }
    section:first-child { grid-row: auto; }
  }
</style>
