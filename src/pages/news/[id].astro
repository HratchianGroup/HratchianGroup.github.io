---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'news'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const dateLabel = new Date(`${post.data.date}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Layout title={`${post.data.title} | Hratchian Research Group`}>
  <main id="main-content">
    <a class="back" href="/news/">← All news</a>
    <article>
      <header>
        <p class="metadata"><time datetime={post.data.date}>{dateLabel}</time></p>
        <h1>{post.data.title}</h1>
        {post.data.categories.length > 0 && <p class="metadata">{post.data.categories.join(' · ')}</p>}
      </header>
      <div class="post-body"><Content /></div>
    </article>
  </main>
</Layout>
<style>
  main { max-width: 800px; }
  .back { display: inline-block; margin-bottom: 2rem; }
  .metadata { color: var(--muted); font-size: 0.9rem; }
  h1 { font-size: clamp(2rem, 4vw, 3rem); }
  header { border-bottom: 1px solid var(--line); padding-bottom: 1rem; margin-bottom: 2rem; }
  .post-body { overflow-wrap: anywhere; }
  .post-body :global(img) { display: block; max-width: 100%; height: auto; max-height: 750px; object-fit: contain; margin: 1.5rem auto; }
  .post-body :global(p) { margin-bottom: 1.25rem; }
</style>
