---
import Layout from '../layouts/Layout.astro';
import { home } from '../data/home';
import { publications } from '../data/publications';

// Automatically show the newest four papers from the shared bibliography.
const recentPublications = [...publications]
  .sort((a, b) => b.year - a.year || b.number - a.number)
  .slice(0, 4);
---

<Layout>
  <main id="main-content">
    <section class="hero" aria-labelledby="home-heading">
      <p class="eyebrow">{home.institution}</p>
      <h1 id="home-heading">{home.heading}</h1>
      <div class="accent-line" aria-hidden="true"></div>
    </section>

    <div class="home-columns">
      <section class="introduction" aria-labelledby="about-heading">
        <h2 id="about-heading">{home.introHeading}</h2>
        <p>{home.researchIntro}</p>
        {home.communityHtml && <p class="community" set:html={home.communityHtml} />}
      </section>

      <section class="recent" aria-labelledby="recent-heading">
        <h2 id="recent-heading">Recent Publications</h2>
        {recentPublications.map((pub) => (
          <article class="recent-publication">
            <p class="publication-year">{pub.year} · Publication {pub.number}</p>
            <p class="citation"><Fragment set:html={pub.citation} /></p>
            {pub.doi && <a class="doi" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer">Read paper <span aria-hidden="true">↗</span><span class="sr-only"> (publication {pub.number})</span></a>}
          </article>
        ))}
        <a class="all-publications" href="/publications/">View all publications <span aria-hidden="true">→</span></a>
      </section>
    </div>
  </main>
</Layout>

<style>
  .hero { padding: 0.5rem 0 3rem; }
  .eyebrow { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  h1 { max-width: 760px; }
  .accent-line { width: 4rem; height: 3px; background: var(--accent); }
  .home-columns { display: grid; grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: start; }
  h2 { margin: 0 0 1.5rem; }
  .introduction { font-size: 1.05rem; }
  .community { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 0.95rem; }
  .recent { border-left: 1px solid var(--line); padding-left: 2rem; }
  .recent-publication { padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .publication-year { font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; letter-spacing: 0.04em; }
  .citation { font-size: 0.9rem; margin-bottom: 0.6rem; overflow-wrap: anywhere; }
  .doi, .all-publications { font-size: 0.85rem; font-weight: bold; }
  .all-publications { display: inline-block; margin-top: 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 800px) {
    .home-columns { grid-template-columns: 1fr; gap: 2.5rem; }
    .recent { border-left: 0; padding-left: 0; }
    .hero { padding-bottom: 2rem; }
  }
</style>
